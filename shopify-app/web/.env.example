# Copy to .env on the server. Never commit .env.
PORT=3000
NODE_ENV=development

# Shopify app (Dev Dashboard -> Dorko NI Payments -> Settings)
SHOPIFY_API_KEY=8d4579a8f96bbf034a0908c76ed8ca52
SHOPIFY_API_SECRET=
# Comma-separated shops allowed to call this server
SHOPIFY_ALLOWED_SHOPS=6zhh3e-ne.myshopify.com

# mock | live   (live needs NI docs and credentials)
NI_MODE=mock
# Mock: how long the fake terminal takes to approve
MOCK_APPROVE_MS=4000

# After this long with no answer, ask NI for the result (Get Result)
RECOVERY_AFTER_MS=20000

DB_PATH=./data.sqlite

# Name of the POS custom payment type (must match Shopify exactly, en dash).
PAYMENT_GATEWAY_NAME=Card – Network International
# Put refunded items back in stock (true/false)
REFUND_RESTOCK=true
