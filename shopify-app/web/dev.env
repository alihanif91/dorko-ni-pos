# Non-secret defaults for local `shopify app dev`. The CLI supplies
# SHOPIFY_API_KEY, SHOPIFY_API_SECRET and PORT itself; real environment
# variables always win over this file.
NODE_ENV=development
NI_MODE=mock
MOCK_APPROVE_MS=4000
RECOVERY_AFTER_MS=20000
SHOPIFY_ALLOWED_SHOPS=dev-demowork.myshopify.com
DB_PATH=./data.sqlite
